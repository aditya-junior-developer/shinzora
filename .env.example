# =============================================================================
# SHINZORA — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored.
#
# PUBLIC values (VITE_/SHINZORA_ prefixed, written into /js/runtime.js by
# `npm run build`) are visible in the browser by design.
#
# SECRET values are read ONLY inside Supabase Edge Functions. They must never
# appear in this file if the file is committed, and never in public/js.
# Set them with `supabase secrets set` instead — see .env.functions.example.
# =============================================================================

# --- Public: Supabase project ------------------------------------------------
# The SHINZORA_* names are the project's own convention. The VITE_* names are
# accepted as aliases by the build script and the dev server, so a host that
# already sets the Vite-style variables works without renaming anything.
SHINZORA_SUPABASE_URL=https://your-project-ref.supabase.co
SHINZORA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# --- Public: site ------------------------------------------------------------
# VITE_SITE_URL and VITE_PUBLIC_SITE_URL are accepted as aliases of the same value.
SHINZORA_SITE_URL=https://shinzora.in
SHINZORA_SUPPORT_EMAIL=support@shinzora.in
SHINZORA_APP_NAME=Shinzora
SHINZORA_ENVIRONMENT=production

# --- Public: payment provider key (publishable) -------------------------------
# Only the public key id is safe here. RAZORPAY_KEY_SECRET belongs to secrets.
SHINZORA_RAZORPAY_KEY_ID=

# --- Pre-launch accounts (server-side verification) --------------------------
# Two accounts that are authenticated by this deployment instead of Supabase
# Auth. Only scrypt digests live here — never a plain password. Provision them
# with:  node scripts/prelaunch-credentials.mjs --init \
#          --user you@business.com --user-password '…' \
#          --admin Owner@identifier --admin-password '…'
# Then check what is configured with:  node scripts/prelaunch-credentials.mjs --show
# PRELAUNCH_USER_EMAIL=business@business.com
# PRELAUNCH_USER_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<digest>
# PRELAUNCH_ADMIN_EMAIL=Shinzora@admin
# PRELAUNCH_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<digest>
# PRELAUNCH_SESSION_SECRET=<32+ characters, generated by --init>
# Optional: write the sandbox store somewhere other than <repo>/.prelaunch
# (required on a read-only serverless host such as Vercel).
# PRELAUNCH_DATA_DIR=/tmp/shinzora-prelaunch

# =============================================================================
# Secrets — reference only. Do not put real values in a committed file.
# Run: supabase secrets set NAME=value
# =============================================================================
# --- AI provider (server-side only) ------------------------------------------
# Never put this key in public/ or in any file a browser downloads.
# Local: add to .env.functions; live: set as Supabase Edge Function secrets.
# Numbered keys and SHINZORA_AI_API_KEYS are supported. All keys without an
# explicit project assignment are treated as one shared quota pool. For multiple
# Google Cloud projects, use SHINZORA_AI_KEYRING (JSON array with id, key,
# projectId, priority, enabled); equal projectId values share one cooldown.
# Legacy single-key names remain supported for older deployments.
#
# Model names are provider-issued, not invented: check
#   GET https://generativelanguage.googleapis.com/v1beta/models
# Free-tier quotas are per model and per day (a text model measured at 20
# requests/day; image models measured at 0 on the free tier). See
# docs/AI-PROVIDER.md before promising generation to a customer.
# SHINZORA_AI_API_KEY_1=
# SHINZORA_AI_API_KEY_2=
# SHINZORA_AI_API_KEY_3=
# SHINZORA_AI_API_KEY_4=
# SHINZORA_AI_KEY_PROJECT_ID=
# SHINZORA_AI_KEYRING=
# SHINZORA_AI_MODEL=gemini-3.8-flash
# SHINZORA_AI_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-3.1-flash-lite

# Quota grouping.
# Default: every numbered key is treated as its own Google project, so a key
# created from a different Google account contributes its own free-tier
# allowance and a spent key rotates to the next one.
# Set to 1 only when all keys come from the SAME project: they then share one
# pool, and one spent allowance parks the whole ring instead of retrying
# siblings that would answer 429 too.
# SHINZORA_AI_SHARED_QUOTA=1
#
# Optional: name a slot's real Google project explicitly.
# SHINZORA_AI_KEY_PROJECT_1=my-google-project-a
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# UPI_ID=
# UPI_PAYEE_NAME=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=
# GITHUB_SCOPES=repo
# VERCEL_TOKEN=
# DOMAIN_PROVIDER=
# DOMAIN_API_URL=
# DOMAIN_API_KEY=
# SUBDOMAIN_ROOT=shinzora.in
# INTEGRATION_ENCRYPTION_KEY=

# --- Domains -------------------------------------------------------------------
# Availability works with no account at all: it is read from the public registry
# (RDAP) and answers "taken or free" — never a price. Set to `off` to disable.
DOMAIN_AVAILABILITY=rdap
# Pricing + registration need a registrar that speaks the provider contract in
# supabase/functions/domains/index.ts.
DOMAIN_PROVIDER=none
DOMAIN_API_URL=
DOMAIN_API_KEY=
SUBDOMAIN_ROOT=shinzora.in

# --- Release tooling only (never shipped, never in the browser) --------------
# Used by scripts/db-backup.mjs, scripts/apply-migrations.mjs and
# scripts/verify-migration.mjs. Leave them empty if you always apply migrations
# through the Supabase dashboard or CLI.
#
# SUPABASE_ACCESS_TOKEN: Supabase → Account → Access tokens. Enables the
#   Management API: backups, applying migrations, and deep verification.
SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_URL: the direct Postgres connection string (Project → Settings →
#   Database). Only needed for a full pg_dump backup.
SUPABASE_DB_URL=
